[Unit]
Description=WynDoze-InfoScanOverload endpoint scan (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Least privilege: the agent only reads local state. Do NOT run as root unless
# a specific collector needs it; prefer a dedicated 'recon' service account
# with read access to the data you want inventoried.
User=recon
Group=recon

# Secrets come from an environment file that is root-owned, chmod 600.
# Contains: RECON_AGENT_TOKEN=... and (optional) RECON_AGENT_ENCRYPTION_KEY=...
EnvironmentFile=/etc/recon/agent.env

# Adjust --role per host: backup_server | proxy | repository |
# domain_controller | jumpbox | workstation | other
ExecStart=/opt/recon/.venv/bin/WynDoze-InfoScanOverload-agent scan \
    --server-url https://recon.example.internal/api/scans \
    --role repository \
    --cache-dir /var/lib/recon/cache

# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/recon/cache

[Install]
WantedBy=multi-user.target
