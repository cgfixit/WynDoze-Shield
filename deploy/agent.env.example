# Copy to /etc/recon/agent.env, chmod 600, root-owned.
# Bearer token the agent presents to the server ingest endpoint.
RECON_AGENT_TOKEN=replace-with-a-long-random-token

# Optional: key for encrypting deferred / isolated-machine bundles.
# Generate with: WynDoze-InfoScanOverload-agent gen-key
RECON_AGENT_ENCRYPTION_KEY=replace-with-a-fernet-key
