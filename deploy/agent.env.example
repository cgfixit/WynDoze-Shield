# Copy to /etc/recon/agent.env, chmod 600, root-owned.
# Bearer token the agent presents to the server ingest endpoint.
Token=replace-with-a-complex-key

# Required by the default --defer behavior and for encrypted isolated bundles.
# Generate with: WynDoze-InfoScanOverload-agent gen-key
ENCRYPTION_KEY=replace-with-a-fernet-key
